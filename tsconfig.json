{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "convex/**/*.test.ts",
    "convex/test.setup.ts",
    "vitest.config.ts",
    "jest.config.js",
    "jest.setup.js"
  ]
}
