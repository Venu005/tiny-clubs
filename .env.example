# Selects the backend profile used by local Expo starts.
EXPO_PUBLIC_APP_ENVIRONMENT=development

# Development Convex deployment URL for local and internal builds.
EXPO_PUBLIC_CONVEX_URL_DEVELOPMENT=

# Staging Convex deployment URL for release validation builds.
EXPO_PUBLIC_CONVEX_URL_STAGING=

# Production Convex deployment URL for user-facing builds.
EXPO_PUBLIC_CONVEX_URL_PRODUCTION=

# Backward-compatible local development fallback.
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key for the selected Clerk instance. Safe for client bundles.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk JWT issuer domain used by Convex auth.config.ts, for example https://example.clerk.accounts.dev.
EXPO_PUBLIC_CLERK_JWT_ISSUER_DOMAIN=

# Google OAuth web client ID configured in Clerk and Google Cloud.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=

# Google OAuth iOS client ID for native Google sign-in.
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=

# Google OAuth Android client ID for native Google sign-in.
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=

# iOS URL scheme for native Google sign-in, usually the iOS client ID prefix before .apps.googleusercontent.com.
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
